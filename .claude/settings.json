{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"/var/home/Kamsiob/Kamiob Apps/-- Android/Health Trail/.claude/hooks/block-destructive.py\"",
            "statusMessage": "Checking command against the destructive command guard",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"/var/home/Kamsiob/Kamiob Apps/-- Android/Health Trail/.claude/hooks/precompact-save-state.sh\"",
            "statusMessage": "Committing and pushing state before compaction",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
