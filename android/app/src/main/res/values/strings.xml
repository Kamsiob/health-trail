<?xml version="1.0" encoding="utf-8"?>
<!--
  Only what the platform itself needs before Compose starts.

  Every user facing string lives in contract/i18n, which both platforms read,
  and is loaded at runtime by the Strings class. Adding copy here would create a
  second place for text to live, and the second place is always the one that
  goes untranslated.
-->
<resources>
    <!-- The app introduces itself by its full name. Not translated: it is a name. -->
    <string name="app_name" translatable="false">Health Trail</string>
</resources>
