<?xml version="1.0" encoding="utf-8"?>
<!--
  There is deliberately no INTERNET permission, and there never will be. The app
  makes no network calls at all. Every permission added here must be justifiable
  to a user in one sentence, and that justification belongs in DECISIONS.md.

  The merged manifest is audited after every dependency addition, because
  libraries commonly introduce permissions silently.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      **Package visibility for the one intent this app resolves.**

      Since Android 11 an app sees only the packages it declares an interest in,
      so `resolveActivity` and `queryIntentActivities` return nothing for a
      recognizer that is installed and working. `DictateAction` hides itself
      when nothing can handle speech input, per rule 11, so without this the
      dictation control would silently vanish on every modern phone while
      appearing to work perfectly on whichever one it was tested on.

      Caught by `lintDebug` through `tools/verify.sh`, which is the reason
      HANDOFF section 8 says to run the verifier rather than the checks anybody
      happens to remember.

      **The list is two entries and every one of them is a control that hides
      itself.** Declaring a query is declaring what this app is allowed to
      notice about the phone, so nothing goes in here to enable a feature. Each
      one is here because rule 11 forbids showing a control that would do
      nothing, and the only way to know it would do nothing is to ask.

      One: whether anything can turn speech into text, for `DictateAction`.

      Two: whether anything can take a new calendar event, for the hand-off in
      `DESIGN.md` 9.1. **That is one event, offered, one way, with nothing read
      back**, and it stays that way: this asks whether a calendar app exists and
      never for permission to read one. No calendar permission is requested here
      or anywhere, and `ACTION_INSERT` needs none, because it opens that app's
      own new event screen and writes nothing.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognizerIntent.ACTION_RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
    </queries>

    <application
        android:name=".HealthTrailApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HealthTrail"
        tools:targetApi="36">

        <!--
          allowBackup is off on purpose. Android's own cloud backup would copy a
          notebook containing another person's health information to a Google
          account, which contradicts the one promise this app makes. Backup here
          is a local export the person creates deliberately, to a folder they
          chose, encrypted with a passphrase they set.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HealthTrail">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Hands a generated document to the system share sheet as a content
          URI. `MASTER_SPEC.md` 4.9: generated locally, no account, no server,
          no link. Not exported, so only the app the person picks from the sheet
          ever gets a read grant, and the grant dies with the activity.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shared"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_paths" />
        </provider>

    </application>
</manifest>
